async def turn_all_to_color(bulbs: List[wizlight], rgb_color_tuple: Tuple[int, int, int] ):
	# make the color type that wizlights use
	color = PilotBuilder(rgb=rgb_color_tuple)
	for bulb in bulbs:
		await bulb.turn_on(color)
		
